      "fixer": { "model": "github-copilot/gpt-6.1-terra", "variant": "low", "skills": [] },
      "council": { "model": "github-copilot/gpt-6.1-terra", "variant": "high", "skills": [] }
    }
  },
  "council": {
    "default_preset": "copilot",

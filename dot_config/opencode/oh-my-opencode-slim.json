    "copilot": {
      "orchestrator": { "model": "github-copilot/gpt-6.1-terra", "variant": "medium", "skills": ["*"] },
      "oracle": { "model": "github-copilot/gpt-6.1-terra", "variant": "high", "skills": ["simplify"] },
      "explorer": { "model": "github-copilot/gpt-6-luna", "variant": "low", "skills": [] },

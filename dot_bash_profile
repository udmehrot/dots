#
# ~/.bash_profile
#

export SHELL=/usr/bin/zsh
export TERMINAL="wezterm"
export BROWSER="vivaldi"
export PATH="$HOME/.local/bin:$PATH"
export MOZ_ENABLE_WAYLAND=1
export MOZ_USE_XINPUT2=1


[[ -f ~/.bashrc ]] && . ~/.bashrc

if [ -t 1 ] && [ -x /usr/bin/zsh ] && [ -z "$ZSH_VERSION" ]; then
    exec /usr/bin/zsh -l
fi

config_version = 16

[bar]
order = [ "default" ]

    [bar.default]
    background_opacity = 0.0
    capsule = true
    capsule_border = "#908caa"
    capsule_border_width = 1.0
    capsule_fill = "surface"
    capsule_opacity = 0.94999999999999996
    capsule_radius = 4
    capsule_thickness = 0.69999999999999996
    center = [ "clock", "weather" ]
    end = [ "widget", "tray", "clipboard", "group:g1", "volume", "battery", "control-center", "notifications", "session" ]
    font_family = "Ioskeley Mono"
    margin_ends = 0
    radius = 0
    scale = 1.2500000111758709
    start = [ "launcher", "wallpaper", "taskbar" ]
    thickness = 40

        [[bar.default.capsule_group]]
        accordion = false
        accordion_direction = "end"
        border = "#908caa"
        border_width = 1.0
        enabled = true
        fill = "surface"
        id = "g1"
        members = [ "network", "bar", "bluetooth" ]
        opacity = 0.94999998807907104
        padding = 6.0
        radius = 4.0

[bluetooth]
connect_when_enabled = true

[idle]
behavior_order = [ "lock", "screen-off" ]
pre_action_fade_seconds = 2.0

    [idle.behavior.lock]
    action = "lock"
    command = ""
    enabled = true
    locked_timeout = 0.0
    resume_command = ""
    timeout = 300.0

    [idle.behavior.screen-off]
    action = "screen_off"
    command = "swaymsg \"output * power off\""
    enabled = true
    locked_timeout = 0.0
    resume_command = "swaymsg \"output * power on\""
    timeout = 600.0

[location]
auto_locate = true

[lockscreen]
allow_empty_password = false
blur_intensity = 0.5
edge_smoothness = 0.29999999999999999
enabled = true
fingerprint = true
grace_period_seconds = 4
lock_before_suspend = true

[lockscreen_widgets]
enabled = true
schema_version = 2
widget_order = [
    "lockscreen-login-box@DP-2",
    "lockscreen-login-box@eDP-1",
    "lockscreen-login-box@DP-4",
    "lockscreen-login-box@DP-3"
]

    [lockscreen_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true


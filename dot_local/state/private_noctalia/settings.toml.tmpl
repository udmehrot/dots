[nightlight]
enabled = true

[plugin_settings."andrewdems/vpn-manager"]
panel_placement = "floating"

[plugins]
enabled = [
    "prponkshe/umbriel-displays",
    "noctalia/wallhaven",
    "davemhammer/obsidian",
    "yugaaank/better-clock",
    "liamwh/emoji-picker",
    "andrewdems/vpn-manager",
    "thepunkoff/pomodoro",
    "0rgl/localsend-plus",
    "nightwatch75/file-search",
    "notfinaldev/web-search",
    "udmehrot/cisco-directory",
    "udmehrot/duckduckgo-search",
    "udmehrot/monitor-layout"
]

[shell]
clipboard_enabled = true
external_ip_enabled = true
font_family = "Ioskeley Mono"
polkit_agent = true

    [shell.launcher]
    width = 760

    [shell.panel]
    border_color = "#908caa"
    clipboard_placement = "floating"
    control_center_placement = "floating"
    launcher_placement = "floating"
    open_near_click_clipboard = true
    open_near_click_control_center = true
    open_near_click_session = true
    open_near_click_wallpaper = true
    polkit_placement = "floating"
    session_placement = "floating"
    transparency_mode = "solid"
    wallpaper_placement = "floating"

    [shell.screenshot]
    annotate = true
    close_on_copy = true
    close_on_save = true
    confirm_region = false
    copy_to_clipboard = true
    directory = "{{ .chezmoi.homeDir }}/Pictures/Screenshots"
    freeze_screen = true
    save_to_file = true

    [shell.window_switcher]
    style = "compact"

[theme]
builtin = "Rosé Pine"
community_palette = "Rose Pine Moon"
mode = "dark"
source = "builtin"
wallpaper_scheme = "vibrant"

    [theme.templates]
    community_ids = [
        "antigravity",
        "claude-code",
        "pi-agent",
        "discord",
        "telegram",
        "lazyvim",
        "neovim",
        "obsidian",
        "vscode",
        "fastfetch",
        "bat",
        "fzf",
        "lazygit",
        "starship",
        "tuios"
    ]
    enable_community_templates = false

[wallpaper]
directory = "{{ .chezmoi.homeDir }}/Pictures/Walls"

    [wallpaper.default]
    path = "{{ .chezmoi.homeDir }}/Pictures/Walls/wallhaven-yqv2wx.jpg"

    [wallpaper.last]
    path = "{{ .chezmoi.homeDir }}/Pictures/Walls/wallhaven-yqv2wx.jpg"

    [wallpaper.monitors.DP-2]
    path = "{{ .chezmoi.homeDir }}/Pictures/Walls/wallhaven-og7yyl.jpg"

    [wallpaper.monitors.DP-3]
    path = "{{ .chezmoi.homeDir }}/Pictures/Walls/wallhaven-yqv2wx.jpg"

    [wallpaper.monitors.DP-4]
    path = "{{ .chezmoi.homeDir }}/Pictures/Walls/wallhaven-yqv2wx.jpg"

    [wallpaper.monitors.eDP-1]
    path = "{{ .chezmoi.homeDir }}/Pictures/Walls/wallhaven-yqv2wx.jpg"

[weather]
unit = "imperial"

[widget.bar]
type = "andrewdems/vpn-manager:bar"

[widget.clock]
format = "{:%A, %b %d}  {:%H:%M:%S}"

[widget.network]
show_label = false

[widget.taskbar]
capsule_radius = "auto"
font_scale = 1.2
group_by_workspace = true
workspace_group_active_border_color = "#908caa"
workspace_label_placement = "centered"

[widget.tray]
hidden = [ "nm-applet" ]

[widget.widget]
type = "0rgl/localsend-plus:widget"

[widget.workspaces]
style = "minimal"

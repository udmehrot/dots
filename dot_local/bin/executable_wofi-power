#!/usr/bin/env bash
# Wofi Power Menu - Rosé Pine Themed

entries="🔒  Lock\n💤  Suspend\n🚪  Logout\n🔄  Reboot\n🛑  Shutdown"

selected=$(echo -e "$entries" | wofi \
    --dmenu \
    --prompt "Power Menu" \
    --width 280 \
    --height 230 \
    --lines 5 \
    --hide-scroll \
    --insensitive \
    --location center)

case "$selected" in
    *"Lock")
        /home/ud/.local/bin/lockscreen
        ;;
    *"Suspend")
        systemctl suspend
        ;;
    *"Logout")
        swaymsg exit
        ;;
    *"Reboot")
        systemctl reboot
        ;;
    *"Shutdown")
        systemctl poweroff
        ;;
esac

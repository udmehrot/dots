add_entry "WezTerm: other default bindings" "See: wezterm show-keys (defaults may overlap Sway)" ''

selected=$(echo -e "$entries" | noctalia dmenu -p "⌨  System Shortcuts & Keybinds")

if [ -n "$selected" ]; then
    cmd="${actions["$selected"]}"
    if [ -n "$cmd" ]; then
        eval "$cmd"
    fi
fi

#!/usr/bin/env bash
# Wofi System Shortcuts Cheat Sheet - Rosé Pine Themed

declare -A actions

add_entry() {
    local key="$1"
    local desc="$2"
    local cmd="$3"
    # Noctalia dmenu renders tab-separated candidates as a title and a
    # secondary description, keeping long descriptions readable at its fixed
    # dmenu width.
    local line=$(printf "%s\t%s" "$key" "$desc")
    entries+="$line\n"
    if [ -n "$cmd" ]; then
        actions["$line"]="$cmd"
    fi
}

entries=""

